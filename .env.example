# ==========================================
# The Coffee Kartel - Backend Environment Example
# Copy this file to .env and fill in real values.
# DO NOT commit real secrets or credentials to git.
# ==========================================

# Active Spring Profile (use 'local' for development, 'mysql' for production)
SPRING_PROFILES_ACTIVE=local

# Server Port
PORT=8081

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_kartel_db
DB_USERNAME=root
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD
DB_URL=jdbc:mysql://localhost:3306/coffee_kartel_db

# JWT Security (must be at least 256 bits / 32 bytes)
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# Administrator Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
