# ==========================================
# The Coffee Kartel - Backend Environment Example
# Copy this file to .env and fill in real values.
# DO NOT commit real secrets or credentials to git.
# ==========================================

# Server Port
PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_kartel_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Security
# Must be at least 256 bits (32 bytes) in Base64 or standard string format
JWT_SECRET=your_cryptographically_secure_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
